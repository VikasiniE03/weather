# ==============================================================================
# AERO-SENSE — AI-BASED WEATHER SENSOR ANOMALY DETECTION SYSTEM
# SIH 2026 Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Persistence Layer
# If MongoDB is running locally or remotely, AERO-SENSE uses Mongoose.
# If MongoDB is unavailable, AERO-SENSE automatically falls back to an atomic
# file-backed JSON store in backend/data/ guaranteeing persistence across restarts.
MONGODB_URI=mongodb://127.0.0.1:27017/aerosense

# Authentication & Security
# Used for signing and verifying JWT tokens for RBAC authentication
JWT_SECRET=aerosense_jwt_super_secret_signing_key_sih2026_production_grade
JWT_EXPIRES_IN=7d

# Spatial-Temporal Telemetry & Anomaly Engine
TELEMETRY_INTERVAL_MS=5000
MAX_HISTORY_POINTS=50
NEIGHBOR_RADIUS_KM=15.0
STUCK_THRESHOLD_CYCLES=5

# Threshold Deviations for Fault Detection
TEMP_DEV_THRESHOLD=3.5
HUM_DEV_THRESHOLD=12.0
PRESS_DEV_THRESHOLD=6.0
SPIKE_TEMP_THRESHOLD=4.0
SPIKE_HUM_THRESHOLD=15.0

# Telecom SMS Gateway Configuration (Optional Real Carrier Dispatch)
# Choose: "SIMULATED", "FAST2SMS", or "TWILIO"
SMS_PROVIDER=SIMULATED

# Fast2SMS (Indian Mobile Delivery)
FAST2SMS_API_KEY=your_fast2sms_authorization_key_here

# Twilio (Global Mobile Delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Anti-Spam SMS Cooldown Window (Milliseconds)
SMS_COOLDOWN_MS=120000
