{
  "name": "aero-sense-sensor-anomaly-detection",
  "version": "1.0.0",
  "description": "Smart India Hackathon (SIH) - AI-based Weather Sensor Anomaly Detection System with Spatial-Temporal Verification",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"node backend/src/server.js\" \"npm --prefix frontend run dev\"",
    "start": "node backend/src/server.js",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "backend": "node backend/src/server.js",
    "frontend": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "sih-2026",
    "weather-station",
    "anomaly-detection",
    "iot-telemetry",
    "haversine",
    "inverse-distance-weighting"
  ],
  "author": "SIH Team",
  "license": "MIT"
}
